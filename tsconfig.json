{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2020",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": "./src",
    "incremental": true,
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src", "prisma"],
  "exclude": ["node_modules", "dist"]
}

